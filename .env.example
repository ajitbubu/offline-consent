# Copy to .env and adjust. .env is gitignored.

DATABASE_URL=postgresql://offline_consent:offline_consent@localhost:5433/offline_consent

# Min 32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Pepper for OTP destination hashes. Changing it invalidates every pending OTP.
# Generate the same way as JWT_SECRET.
OTP_PEPPER=

# Where scanned evidence is written. Gitignored, must stay outside public/.
EVIDENCE_DIR=./.evidence

# How long evidence is retained. Stamped onto each object at upload time, so
# changing this never moves the retention date of anything already stored.
EVIDENCE_RETENTION_YEARS=8

# Used for the Origin check on mutating staff routes.
APP_ORIGIN=http://localhost:1002

# The Data Fiduciary's name, shown in the header and footer of every public
# page. Set this: a person who signed a paper form needs to know whose consent
# register they have landed on before they type their phone number into it.
ORG_NAME=Example Society

# The civil timezone this register operates in. Paper dates are compared against
# withdrawal timestamps in this zone; setting it wrong shifts those comparisons
# by a day and can resurrect a withdrawn consent. IANA name.
APP_TIMEZONE=Asia/Kolkata

# Print OTP codes to the server console instead of sending them. Dev only.
OTP_DEV_ECHO=true

# OCR and tick-box extraction service (./ml). Unset = extraction skipped and the
# review screen is plain manual entry - which is the same screen, so nothing
# breaks. Set it to start banking OCR tokens: every scan reviewed WITHOUT it is a
# training pair lost, and text extraction needs roughly fifty to a hundred of
# them before it can be built at all.
ML_SERVICE_URL=http://localhost:8000

# Believe X-Forwarded-For. Only enable when a proxy in front of the app
# overwrites that header, otherwise per-IP rate limits become trivially
# bypassable.
TRUST_PROXY=false
