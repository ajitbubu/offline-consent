{
  "name": "offline-consent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 1002",
    "build": "next build",
    "start": "next start -p 1002",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "db:reset": "node --env-file-if-exists=.env scripts/reset-db.mjs",
    "calibrate": "node --env-file-if-exists=.env scripts/calibrate-tickbox.mjs",
    "extract:batch": "node --env-file-if-exists=.env scripts/extract-batch.mjs",
    "sample:form": "node --env-file-if-exists=.env scripts/make-sample-form.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.12",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
